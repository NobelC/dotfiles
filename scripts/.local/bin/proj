#!/usr/bin/env bash
# proj — project picker & automation hub
# Overrides por proyecto: .projrc con PROJ_BUILD/PROJ_RUN/PROJ_TEST/PROJ_LINT/PROJ_FMT

set -uo pipefail

PROJECTS_DIR="${PROJECTS_DIR:-$HOME/GitHub-Repo}"
EXTRA_PROJECTS=("$HOME/dotfiles")
JOBS=$(nproc)

die() { echo "✗ $*" >&2; }
ok() { echo "✓ $*"; }
pause() { read -rp "Pulsa ENTER para continuar…" _; }

# ---------- descubrimiento ----------
detect_lang() {
  local d="$1"
  [ -f "$d/go.mod" ] && {
    echo go
    return
  }
  if [ -f "$d/pyproject.toml" ] || [ -f "$d/setup.py" ] || [ -f "$d/requirements.txt" ] || [ -f "$d/main.py" ]; then
    echo python
    return
  fi
  if [ -f "$d/CMakeLists.txt" ] || compgen -G "$d/*.cpp" >/dev/null 2>&1 || compgen -G "$d/src/*.cpp" >/dev/null 2>&1; then
    echo cpp
    return
  fi
  if compgen -G "$d/*.c" >/dev/null 2>&1; then
    echo c
    return
  fi
  if compgen -G "$d/*.lua" >/dev/null 2>&1 || [ -f "$d/.luarc.json" ]; then
    echo lua
    return
  fi
  if compgen -G "$d/*.sh" >/dev/null 2>&1; then
    echo bash
    return
  fi
  echo unknown
}

list_projects() {
  local d
  for d in "$PROJECTS_DIR"/* "${EXTRA_PROJECTS[@]}"; do
    [ -d "$d/.git" ] || continue
    printf '%s\t%s\t%s\n' "$(basename "$d")" "$(detect_lang "$d")" "$d"
  done | sort
}

load_projrc() {
  PROJ_BUILD=""
  PROJ_RUN=""
  PROJ_TEST=""
  PROJ_LINT=""
  PROJ_FMT=""
  [ -f .projrc ] && source .projrc
}

# ---------- preview (lo llama fzf) ----------
preview() {
  local d="$1"
  cd "$d" || exit 1
  echo "── $(basename "$d") [$(detect_lang "$d")] ──"
  echo "branch: $(git branch --show-current)   dirty: $(git status --porcelain 2>/dev/null | wc -l)"
  git log -1 --format='last:   %cr  %s' 2>/dev/null
  echo
  git log --oneline -6 2>/dev/null
  echo
  echo "── status ──"
  git status -sb 2>/dev/null | head -8
}

# ---------- acciones por lenguaje ----------
do_build() {
  load_projrc
  [ -n "$PROJ_BUILD" ] && {
    eval "$PROJ_BUILD"
    return
  }
  case "$LANG" in
  cpp | c)
    if [ -f CMakeLists.txt ]; then
      [ -d build ] || cmake -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
      cmake --build build -j"$JOBS"
    elif [ -f Makefile ]; then
      make -j"$JOBS"
    else die "sin build system: define PROJ_BUILD en .projrc"; fi
    ;;
  go) go build ./... ;;
  python) pybin -m compileall -q . && ok "syntax ok" ;;
  bash) shellcheck *.sh && ok "shellcheck ok" ;;
  lua) luac -p *.lua && ok "syntax ok" ;;
  *) die "lenguaje sin build definido" ;;
  esac
}

pybin() { if [ -x .venv/bin/python ]; then .venv/bin/python "$@"; else python "$@"; fi; }

do_run() {
  load_projrc
  [ -n "$PROJ_RUN" ] && {
    eval "$PROJ_RUN"
    return
  }
  case "$LANG" in
  cpp | c)
    [ -d build ] || do_build || return 1
    local bin
    bin=$(find build -maxdepth 3 -type f -perm -u+x ! -name '*.o' ! -name '*.a' ! -name '*.cmake' 2>/dev/null |
      fzf --height=30% --border --prompt='binario  ')
    [ -n "$bin" ] && "$bin"
    ;;
  go) go run . ;;
  python)
    local e
    e=$([ -f main.py ] && echo main.py || find . -maxdepth 2 -name '*.py' ! -path './.venv/*' | fzf --height=30% --border)
    [ -n "$e" ] && pybin "$e"
    ;;
  bash)
    local s
    s=$(find . -maxdepth 2 -name '*.sh' | fzf --height=30% --border)
    [ -n "$s" ] && bash "$s"
    ;;
  lua) lua "${1:-main.lua}" ;;
  esac
}

do_test() {
  load_projrc
  [ -n "$PROJ_TEST" ] && {
    eval "$PROJ_TEST"
    return
  }
  case "$LANG" in
  cpp | c) ctest --test-dir build --output-on-failure 2>/dev/null || make -C build test ;;
  go) go test ./... ;;
  python) pybin -m pytest -q ;;
  bash) [ -d tests ] && bats tests/ || die "sin tests/ (bats)" ;;
  lua) command -v busted >/dev/null && busted || die "busted no instalado" ;;
  esac
}

do_lint() {
  load_projrc
  [ -n "$PROJ_LINT" ] && {
    eval "$PROJ_LINT"
    return
  }
  case "$LANG" in
  cpp | c) [ -f compile_commands.json ] || [ -f build/compile_commands.json ] &&
    find src -name '*.cpp' -o -name '*.c' 2>/dev/null | xargs -r clang-tidy -p build 2>/dev/null ||
    die "clang-tidy necesita compile_commands.json (compila primero)" ;;
  go) go vet ./... ;;
  python) pybin -m ruff check . 2>/dev/null || die "ruff no instalado" ;;
  bash) shellcheck *.sh ;;
  lua) luacheck . 2>/dev/null || die "luacheck no instalado" ;;
  esac
}

do_fmt() {
  load_projrc
  [ -n "$PROJ_FMT" ] && {
    eval "$PROJ_FMT"
    return
  }
  case "$LANG" in
  cpp | c) find . -name '*.cpp' -o -name '*.c' -o -name '*.h' -o -name '*.hpp' | xargs -r clang-format -i ;;
  go) gofmt -w . ;;
  python) pybin -m ruff format . 2>/dev/null || die "ruff no instalado" ;;
  bash) shfmt -w *.sh ;;
  lua) die "define PROJ_FMT (stylua/luafmt)" ;;
  esac
}

# ---------- git ----------
git_commit_all() {
  git add -A
  git diff --cached --stat | tail -3
  local type subject
  type=$(printf 'feat\nfix\nrefactor\ndocs\ntest\nchore\nperf\n' | fzf --height=30% --border --prompt='tipo  ')
  [ -z "$type" ] && return
  read -rp "sujeto: " subject
  [ -n "$subject" ] && git commit -m "$type: $subject"
}

git_branch() {
  local br
  br=$({
    echo -e "#NEW\tcrear rama nueva"
    git branch -a --format='%(refname:short)' | sort -u
  } |
    fzf --delimiter='\t' --with-nth=1,2 --height=40% --border --prompt='rama  ' | cut -f1)
  [ -z "$br" ] && return
  if [ "$br" = "#NEW" ]; then
    read -rp "nombre: " br
    [ -n "$br" ] && git switch -c "$br"
  else
    git switch "${br#origin/}" 2>/dev/null || git switch --track "$br"
  fi
}

git_delbranch_remote() {
  local br conf
  br=$(git branch -r --format='%(refname:short)' | sed 's|^origin/||' | grep -vE '^(main|master|HEAD)$' |
    fzf --height=40% --border --prompt='borrar rama remota  ')
  [ -z "$br" ] && return
  read -rp "confirma escribiendo '$br': " conf
  [ "$conf" = "$br" ] && git push origin --delete "$br" || die "confirmación no coincide"
}

del_local() {
  local name conf
  name=$(basename "$PWD")
  read -rp "⚠ BORRARÁ $PWD. confirma escribiendo '$name': " conf
  [ "$conf" = "$name" ] || {
    die "confirmación no coincide"
    return 1
  }
  cd ~ || return 1
  rm -rf "$PROJECTS_DIR/$name" && ok "borrado $name"
}

del_remote() {
  local name conf
  name=$(basename "$PWD")
  if ! command -v gh >/dev/null 2>&1; then
    die "instala gh: sudo pacman -S gh"
    return 1
  fi
  read -rp "⚠ BORRARÁ el repo remoto '$name'. confirma escribiendo '$name': " conf
  [ "$conf" = "$name" ] || {
    die "confirmación no coincide"
    return 1
  }
  gh repo delete "$name" --yes && ok "repo remoto borrado"
}

# ---------- scaffolding ----------
scaffold() {
  local dir="$1" lang="$2" name="$3"
  mkdir -p "$dir"
  case "$lang" in
  cpp | c)
    local std="CXX" ext="cpp"
    [ "$lang" = c ] && {
      std="C"
      ext="c"
    }
    mkdir -p "$dir/src"
    cat >"$dir/CMakeLists.txt" <<EOF
cmake_minimum_required(VERSION 3.20)
project($name LANGUAGES $std)
set(CMAKE_${std}_STANDARD 20)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
add_executable($name src/main.$ext)
enable_testing()
EOF
    cat >"$dir/src/main.$ext" <<'EOF'
#include <cstdio>
int main() { std::puts("hola"); }
EOF
    [ "$lang" = c ] && cat >"$dir/src/main.c" <<'EOF'
#include <stdio.h>
int main(void) { puts("hola"); }
EOF
    echo "build/" >"$dir/.gitignore"
    ;;
  go)
    cd "$dir" && go mod init "github.com/nobel/$name" >/dev/null 2>&1
    cat >"$dir/main.go" <<'EOF'
package main

import "fmt"

func main() { fmt.Println("hola") }
EOF
    ;;
  python)
    cat >"$dir/main.py" <<'EOF'
def main() -> None:
    print("hola")

if __name__ == "__main__":
    main()
EOF
    printf '.venv/\n__pycache__/\n' >"$dir/.gitignore"
    ;;
  bash)
    cat >"$dir/main.sh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
echo "hola"
EOF
    chmod +x "$dir/main.sh"
    ;;
  lua)
    cat >"$dir/main.lua" <<'EOF'
print("hola")
EOF
    ;;
  esac
}

new_project() {
  local name lang
  name=$(fzf --print-query --height=15% --border --prompt='nombre  ' </dev/null | tail -1)
  [ -z "$name" ] && return
  lang=$(printf 'cpp\nc\ngo\npython\nbash\nlua\n' | fzf --height=30% --border --prompt='lenguaje  ')
  [ -z "$lang" ] && return
  local dir="$PROJECTS_DIR/$name"
  [ -e "$dir" ] && {
    die "ya existe $dir"
    return 1
  }
  scaffold "$dir" "$lang" "$name"
  git -C "$dir" init -q
  git -C "$dir" add -A
  git -C "$dir" commit -qm "chore: scaffold $lang project"
  ok "creado $dir"
  local yn
  read -rp "¿crear remote y pushear? (s/N): " yn
  if [[ "$yn" =~ ^[sS] ]]; then
    if command -v gh >/dev/null 2>&1; then
      gh repo create "$name" --private --source="$dir" --push && ok "remote creado"
    else
      die "gh no instalado: crea el repo a mano y git push -u origin master"
    fi
  fi
}

# ---------- bulk sync ----------
sync_all() {
  local sel
  sel=$(list_projects | while IFS=$'\t' read -r n l p; do
    local dirty ahead
    dirty=$(git -C "$p" status --porcelain 2>/dev/null | wc -l)
    ahead=$(git -C "$p" log --oneline '@{u}..' 2>/dev/null | wc -l)
    [ "$dirty" -gt 0 ] || [ "$ahead" -gt 0 ] && printf '%s\t%s dirty, %s unpushed\t%s\n' "$n" "$dirty" "$ahead" "$p"
  done | fzf --delimiter='\t' --with-nth=1,2 --multi --height=60% --border \
    --header='TAB marca · ENTER procesa seleccionados' | cut -f3)
  [ -z "$sel" ] && return
  local p msg
  while read -r p; do
    [ -z "$p" ] && continue
    echo "── $p ──"
    git -C "$p" status -sb | head -5
    read -rp "mensaje (enter para skip): " msg
    [ -z "$msg" ] && continue
    git -C "$p" add -A
    git -C "$p" commit -qm "chore: $msg"
    git -C "$p" push && ok "$p pusheado"
  done <<<"$sel"
}

# ---------- doctor ----------
doctor() {
  local -A need=(
    [cmake]="cpp" [make]="cpp" [clangd]="cpp" [clang - tidy]="cpp" [clang - format]="cpp" [ctest]="cpp"
    [go]="go" [python]="python" [pytest]="python" [ruff]="python"
    [shellcheck]="bash" [shfmt]="bash" [bats]="bash"
    [lua]="lua" [luacheck]="lua" [busted]="lua"
    [gh]="git-remoto" [lazygit]="git-ui"
  )
  local t lang missing=0
  for t in "${!need[@]}"; do
    if ! command -v "$t" >/dev/null 2>&1; then
      printf '✗ %-14s (%s)\n' "$t" "${need[$t]}"
      missing=1
    fi
  done
  [ "$missing" -eq 0 ] && ok "toolchain completo" || echo "→ sudo pacman -S <los que falten>"
}

# ---------- menús ----------
menu_actions() {
  local lang="$1"
  {
    case "$lang" in
    cpp | c) echo -e "build\tcompilar\nrun\tejecutar binario\ntest\tctest\nlint\tclang-tidy\nfmt\tclang-format" ;;
    go) echo -e "build\tgo build\nrun\tgo run .\ntest\tgo test\nlint\tgo vet\nfmt\tgofmt" ;;
    python) echo -e "run\tejecutar entrypoint\ntest\tpytest\nlint\truff check\nfmt\truff format\nvenv\tcrear venv" ;;
    bash) echo -e "run\tejecutar script\ntest\tbats\nlint\tshellcheck\nfmt\tshfmt" ;;
    lua) echo -e "run\tlua main\ntest\tbusted\nlint\tluacheck" ;;
    *) echo -e "run\tintentar ejecutar" ;;
    esac
    echo -e "edit\tabrir en nvim\nstatus\tgit status + diff\ncommit\tcommit de todo\npush\tpush\npull\tpull --rebase\nbranch\tcambiar/crear rama\ndelbranch\tborrar rama remota\ndellocal\tBORRAR proyecto local\ndelremote\tBORRAR repo remoto"
  } | fzf --delimiter='\t' --with-nth=1,2 --height=60% --border --prompt='acción  ' | cut -f1
}

main_menu() {
  local dir
  dir=$(list_projects | fzf --delimiter='\t' --with-nth=1,2 --height=60% --border \
    --prompt='proyecto  ' --preview="proj preview {3}" --preview-window='right:55%' | cut -f3)
  [ -z "$dir" ] && return
  cd "$dir" || return
  LANG=$(detect_lang "$dir")
  while true; do
    local act
    act=$(menu_actions "$LANG")
    [ -z "$act" ] && break
    case "$act" in
    build)
      do_build
      pause
      ;;
    run)
      do_run
      pause
      ;;
    test)
      do_test
      pause
      ;;
    lint)
      do_lint
      pause
      ;;
    fmt)
      do_fmt
      pause
      ;;
    venv)
      [ -d .venv ] || python -m venv .venv
      ok "venv listo (las acciones lo usan solo)"
      ;;
    edit)
      nvim . &
      break
      ;;
    status)
      git status -sb
      git diff --stat | tail -5
      pause
      ;;
    commit) git_commit_all ;;
    push) git push && ok pushed ;;
    pull) git pull --rebase ;;
    branch) git_branch ;;
    delbranch) git_delbranch_remote ;;
    dellocal) del_local && break ;;
    delremote) del_remote ;;
    esac
  done
}

# ---------- entry ----------
case "${1:-menu}" in
preview) preview "$2" ;;
new) new_project ;;
sync) sync_all ;;
doctor) doctor ;;
path) list_projects | fzf --delimiter='\t' --with-nth=1,2 --height=50% --border | cut -f3 ;;
menu | "") main_menu ;;
*) die "uso: proj [menu|new|sync|doctor|path|preview DIR]" ;;
esac
